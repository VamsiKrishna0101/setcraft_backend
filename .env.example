# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# Redis Cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication & JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=8000

# Social Auth / Firebase
SOCIAL_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-admin.json

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="FitAI"
PUBLIC_APP_URL=
EMAIL_LOGO_URL=

# Cloudflare R2 Storage
EXERCISE_VIDEO_BASE_URL=
EXERCISE_GIF_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BODY_BUCKET_NAME=
R2_BODY_PUBLIC_URL=
R2_EXERCISE_PUBLIC_URL=
R2_EXERCISE_FEMALE_PUBLIC_URL=
R2_EXERCISE_IMAGES_PUBLIC_URL=
R2_FOOD_PUBLIC_URL=

# AI & LLM Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=medium
AI_PROVIDER_NAME=OpenAI

# MCP (Model Context Protocol)
MCP_TOKEN_HASH_KEY_BASE64=
MCP_PUBLIC_URL=

# In-App Subscriptions & Store Billing
GOOGLE_PLAY_PACKAGE_NAME=com.fitai.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=secrets/google-play.json
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_EMAIL=
SUBSCRIPTION_TERMS_URL=
SUBSCRIPTION_PRIVACY_URL=

# Support & Privacy
SUPPORT_EMAIL=
PRIVACY_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=
PRIVACY_POLICY_UPDATED=

# App Store & Rating Redirect (Dynamic Review Link)
APP_REVIEW_URL=https://setcraft.app/feedback

